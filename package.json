{
  "name": "nova-chat",
  "version": "1.1.31",
  "private": true,
  "description": "Characterful AI companions and a capable everyday assistant, with customizable personas, character photos, multi-model chat and a self-hosted gateway.",
  "repository": {
    "type": "git",
    "url": "https://github.com/dyhxxs/nova-chat.git"
  },
  "homepage": "https://github.com/dyhxxs/nova-chat",
  "bugs": {
    "url": "https://github.com/dyhxxs/nova-chat/issues"
  },
  "keywords": [
    "ai-companion",
    "character-chat",
    "ai-chat",
    "android",
    "ios",
    "expo",
    "react-native",
    "self-hosted",
    "openai-compatible",
    "gateway",
    "multi-user",
    "typescript",
    "llm",
    "knowledge-base"
  ],
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n gateway,mobile -c cyan,magenta npm:dev:gateway npm:dev:mobile",
    "predev:gateway": "npm run build -w @nova-chat/protocol",
    "dev:gateway": "npm run dev -w @nova-chat/gateway",
    "predev:mobile": "npm run build -w @nova-chat/protocol",
    "dev:mobile": "npm run start -w @nova-chat/mobile",
    "build": "npm run build -w @nova-chat/protocol && npm run build -w @nova-chat/gateway",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "verify": "npm run typecheck && npm run test && npm run test:scripts && npm run lint",
    "postinstall": "npm run build -w @nova-chat/protocol",
    "assets": "python scripts/generate_assets.py",
    "tunnel:gateway": "powershell -ExecutionPolicy Bypass -File scripts/start_gateway_tunnel.ps1",
    "share:builds": "powershell -ExecutionPolicy Bypass -File scripts/start_download_tunnel.ps1",
    "share:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop_download_tunnel.ps1",
    "test:scripts": "node --test scripts/test/*.test.mjs",
    "gateway:check": "node scripts/check_gateway.mjs",
    "gateway:check-chat": "node scripts/check_gateway_chat.mjs",
    "gateway:smoke": "node scripts/check_gateway_runtime.mjs",
    "gateway:backup": "node scripts/backup_gateway.mjs",
    "gateway:backup:verify": "node scripts/backup_gateway.mjs --verify",
    "gateway:backup:restore": "node scripts/backup_gateway.mjs --restore",
    "benchmark:mobile": "node --import tsx scripts/benchmark_mobile.mjs",
    "knowledge:evaluate": "node --import tsx scripts/evaluate_knowledge.mjs",
    "knowledge:compare": "node --import tsx scripts/evaluate_knowledge.mjs --strategy compare --output-dir artifacts/knowledge-evaluation-compare",
    "security:audit:gateway": "npm audit --workspace @nova-chat/gateway --omit=dev --audit-level=high",
    "gateway:e2e": "node --import tsx scripts/gateway_e2e.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "react-native-svg": "15.15.4",
    "react-native": "0.86.3",
    "react": "19.2.3",
    "uuid": "^11.1.1"
  }
}
