# Nova Chat 网关环境变量示例
# 复制为 services/gateway/.env 后再修改。不要把真实密钥提交到仓库或写入 APK。

NODE_ENV=production
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info
# 只有在网关位于可信反向代理之后才设为 true；否则客户端可以伪造转发来源地址。
TRUST_PROXY=false
DATA_DIR=/app/data

# 必填：用于 AES-256-GCM 加密管理员保存的第三方 API Key。
# 生产环境必须显式设置独立主密钥，至少 32 个字符；不要复用 APP_ACCESS_TOKEN。
# 部署后不可随意更换，否则已保存的 Key 无法解密。
SERVER_MASTER_KEY=replace-with-at-least-32-random-characters

# 必填：首次创建管理员账户时使用，生产环境至少 24 个字符。
# 管理员创建完成后仍建议保留在服务器秘密管理中，不要发给普通用户。
ADMIN_BOOTSTRAP_TOKEN=replace-with-at-least-24-random-characters

# 可选：如启用自动创建管理员，必须同时通过安全的环境变量注入 ADMIN_PASSWORD（至少 8 位）。
# 默认关闭自动创建，首次部署通过 App 的管理员初始化流程完成设置。
ADMIN_EMAIL=admin@qq.com
ADMIN_DISPLAY_NAME=管理员
ADMIN_AUTO_CREATE=false

# 是否允许 App 自助注册。关闭后，已有用户仍可登录，管理员仍可管理账户。
REGISTRATION_ENABLED=true
SESSION_DAYS=30
# 单个来源地址+账户在窗口内允许的登录尝试次数。
LOGIN_ATTEMPTS_PER_WINDOW=10
LOGIN_WINDOW_MS=900000

# 以下 OPENAI_* 仅作为数据库尚未保存管理员配置时的服务器初始值。
# 推荐部署后由 App 的“管理控制台”统一填写第三方 Base URL、Key、协议和模型。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol
ALLOWED_MODELS=gpt-5.6-sol
PROVIDER_API_MODE=responses
PROVIDER_AUTH_MODE=bearer
# 检索排序策略：lexical 为默认稳定策略；bm25 用于受控实验和灰度评估。
KNOWLEDGE_RETRIEVAL_STRATEGY=lexical

# 旧版共享口令兼容项。新部署请留空并使用注册/登录；Legacy 用户不能上传附件。
APP_ACCESS_TOKEN=

# 跨域来源。纯原生 App 可保持 *；若同时部署 Web 前端，建议改为明确域名。
CORS_ORIGINS=*

# 可选强制升级策略。0 表示不强制升级；开启时下载地址必须是 HTTPS。
NOVA_MINIMUM_APP_VERSION_CODE=0
NOVA_LATEST_APP_VERSION=1.1.31
NOVA_LATEST_APP_VERSION_CODE=33
NOVA_APP_DOWNLOAD_URL=

# 可选 Prometheus 指标。生产环境开启时必须设置至少 24 位的 METRICS_TOKEN。
METRICS_ENABLED=false
METRICS_TOKEN=

REQUESTS_PER_MINUTE=20
MAX_CONCURRENT_PER_DEVICE=2
# 所有用户共用同一图片服务账号时，网关允许最多 100 个图片请求同时进入上游。
# 如果服务商账号存在更低的并发配额，请按实际配额调小。
MAX_CONCURRENT_IMAGE_REQUESTS=100
IMAGE_CONCURRENCY_RETRY_COUNT=2
IMAGE_CONCURRENCY_RETRY_BASE_MS=5000
IMAGE_CONCURRENCY_RETRY_MAX_MS=20000
MAX_HISTORY_CHARS=600000
MAX_OUTPUT_TOKENS=32768
MAX_FILE_BYTES=26214400

MAX_HISTORY_MESSAGES=400

# 网关内置常用工具（默认开启；旧版客户端不传 autoTools 也可用）。
# 不需要上游服务支持原生 web_search/code_interpreter。
BUILTIN_TOOLS_ENABLED=true
# 设备未上报有效时区时使用此默认值；不是用户 GPS 位置。
DEFAULT_TIMEZONE=Asia/Shanghai
# 每次外部工具请求总超时，100–60000ms；每轮最多12次工具调用、4轮模型工具交互。
TOOL_TIMEOUT_MS=12000
# 可选，稳定搜索接入。留空使用 Bing RSS 免密钥备用入口（尽力而为、无可用性保证）。
BRAVE_SEARCH_API_KEY=
# 天气默认使用 Open-Meteo 免费非商业服务；商业部署请按服务条款改接合适的付费/自托管服务。

# Voice relay: async /v1/media/generate TTS + native Gemini audio transcription.
# Leave blank to use the companion chat provider credentials. Keys remain on the gateway.
VOICE_API_KEY=
VOICE_BASE_URL=
VOICE_TTS_MODEL=doubao-tts-2.0
VOICE_ASR_MODEL=gem-3.8-flash
VOICE_DEFAULT_ID=zh_female_vv_uranus_bigtts
# Optional administrator-owned speech-2.8 clone. Replaces all female preset choices.
VOICE_FEMALE_CLONE_ID=
VOICE_FEMALE_CLONE_NAME=少女音 · 专属音色

# Optional: server-only Expo push token for projects with push access security enabled.
EXPO_ACCESS_TOKEN=
