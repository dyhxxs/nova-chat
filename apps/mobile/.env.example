# Public build-time Gateway address. Production builds should set this so users do not need to enter a server address.
# This value is embedded in the App bundle, so it must never contain credentials or tokens.
EXPO_PUBLIC_GATEWAY_URL=https://chat.example.com

# If the server currently has no certificate, an explicit public IPv4 + HTTP
# build is supported. Use the build scripts with -AllowHttpIp; do not put
# credentials in this URL. The Android/iOS cleartext flags are set by the
# scripts when this mode is selected.
# EXPO_PUBLIC_GATEWAY_URL=http://YOUR_SERVER_IP:8787
# ALLOW_CLEARTEXT=true
